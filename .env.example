# Copy this file to ".env" (same folder) and fill in your real info.
# ".env" is in .gitignore on purpose -- it never gets committed to git,
# because it's meant for things specific to your machine.
#
# SEC EDGAR requires this so it can identify who's making requests. It
# is NOT a secret and NOT an API key -- just an honest name + email.
EDGAR_CONTACT_NAME=Kevin Dumler
EDGAR_CONTACT_EMAIL=shebnitz@gmail.com
